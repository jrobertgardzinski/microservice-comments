<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jrobertgardzinski</groupId>
        <artifactId>microservice-comments</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>comments_account-closure</artifactId>

    <!--
      This service's side of ONE cross-service process: closing an account. Read this module and
      you know what happens to a person's comments when they leave — the three commands, which is
      reversible, whose conditions count — without first deciding whether the portal is a monolith
      or six services. Nothing in here knows Kafka, HTTP, Spring or a database; the adapter that
      carries the commands does, and lives next door in comments-infrastructure.

      THE UNDERSCORE IS THE POINT. `comments-<x>` is a LAYER of this service; `comments_<x>` is
      this service's part in a process it shares with others, named after the library the
      participants speak through. memes_account-closure is the other end of this same
      conversation, and neither is a layer.
    -->
    <dependencies>
        <dependency>
            <!-- the three words that say what becomes of a leaver's content; shared with the
                 twin service that also holds authored content -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>purge-rule</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>comments-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>comments-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>comments-config</artifactId>
        </dependency>
        <dependency>
            <!-- the words the participants and the orchestrator share, including the parsed
                 command every participant reads -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>account-closure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>observation</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
