{
  "consumer": {
    "name": "microservice-comments"
  },
  "messages": [
    {
      "contents": {
        "memeId": "known-meme",
        "type": "MEME_DELETED"
      },
      "description": "a meme deleted announcement for the comment thread",
      "matchingRules": {
        "body": {
          "$.memeId": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metaData": {
        "contentType": "application/json"
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "microservice-memes"
  }
}
