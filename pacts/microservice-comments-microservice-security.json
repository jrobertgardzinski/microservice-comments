{
  "consumer": {
    "name": "microservice-comments"
  },
  "messages": [
    {
      "contents": {
        "email": "alice@new.example.com",
        "oldEmail": "alice@old.example.com",
        "type": "EMAIL_CHANGED"
      },
      "description": "an email changed fact",
      "matchingRules": {
        "body": {
          "$.email": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          },
          "$.oldEmail": {
            "combine": "AND",
            "matchers": [
              {
                "match": "type"
              }
            ]
          }
        }
      },
      "metaData": {
        "contentType": "application/json"
      }
    }
  ],
  "metadata": {
    "pact-jvm": {
      "version": "4.7.5"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "microservice-security"
  }
}
