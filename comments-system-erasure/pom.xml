<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jrobertgardzinski</groupId>
        <artifactId>microservice-comments</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>comments-system-erasure</artifactId>

    <!-- The use cases that take comments down: a whole thread when its meme goes, or one
         leaver's comments wherever they are. Below the use cases that put comments up, and
         reachable without them. -->
    <dependencies>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>comments-system-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- the three words that say what becomes of a leaver's content -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>purge-rule</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>comments-domain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>comments-domain-votes</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>comments-domain-erasure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>comments-config-erasure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>user-id</artifactId>
        </dependency>
        <dependency>
            <!-- the port a service states its own facts through; the facts themselves stay ours -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>observation</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- the ports' fakes, beside the ports -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>comments-domain-votes</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- the ports' fakes, beside the ports -->
            <groupId>com.jrobertgardzinski</groupId>
            <artifactId>comments-domain-erasure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
